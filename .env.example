# ---- 送信者の表示（特定電子メール法で必須。空のままだと送信できません）----
SENDER_COMPANY=
SENDER_PERSON=
SENDER_ADDRESS=
SENDER_TEL=
SENDER_EMAIL=
# 受信拒否（配信停止）の連絡先。空なら SENDER_EMAIL を使います
OPTOUT_EMAIL=
REPLY_TO=

# ---- 文面の差し込み ----
SERVICE_START=
DEMO_URL=https://analink.lextribe.com/

# ---- 送信（SMTP）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# starttls / ssl / none
SMTP_SECURITY=starttls
# 1日に送る上限と、1通ごとの間隔（秒）
DAILY_LIMIT=20
SEND_INTERVAL_SEC=60

# ---- 返信の取り込み（IMAP）----
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# ---- 巡回 ----
CRAWL_USER_AGENT=AutoSalesBot/0.1
CRAWL_DELAY_SEC=2
CRAWL_MAX_PAGES=6

DB_PATH=data/autosales.db
